# Godot 4+ specific ignores
.godot/
/android/
.freebuff/

# Exported builds
/export/
/build/

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
# Reference/design docs (not shipped): demo parity plan + docs/reference
demo_parity_plan/
docs/reference/

# Godot editor metadata (.uid files) — regenerated per workspace
*.uid

# Third-party art packs whose licence forbids redistributing the assets on their own
# (e.g. Fantasy Battle Pack): kept locally only, the game falls back to flat colours.
assets/third_party/*
!assets/third_party/README.md
