[gd_resource type="Resource" script_class="DialogueData" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/dialogues/dialogue_data.gd" id="1"]

[resource]
script = ExtResource("1")
id = "dlg_ch01_intro"
display_name = "Ch01 Intro"
lines = Array[Dictionary]([{"speaker": "Swordsman", "text": "A treaty was signed. That does not mean the war is over for everyone."}, {"speaker": "Beastwoman", "text": "Those holdouts on the border will not listen unless we beat them honestly... and leave them standing."}, {"speaker": "Swordsman", "text": "Then we finish this with as few graves as possible."}])
